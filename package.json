{
  "name": "fraud-detection-payment-system",
  "version": "1.0.0",
  "description": "Financial Fraud Detection & Payment Transaction System - a DBMS Lab project implementing a normalized relational schema, ACID-compliant transaction processing, and a rule-based in-database fraud detection engine.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:reset": "node scripts/setup-db.js --reset",
    "stress": "node scripts/stress-test.js",
    "simulate": "node scripts/simulate-fraud.js"
  },
  "keywords": [
    "dbms",
    "fraud-detection",
    "mysql",
    "transactions",
    "acid"
  ],
  "author": "Team Sentinel",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  }
}
